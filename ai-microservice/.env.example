# Copiar a .env y completar
ENV=development
# LLM_PROVIDER: mock | google | ollama
LLM_PROVIDER=mock
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# OCR_PROVIDER: mock | google | huggingface
OCR_PROVIDER=mock
HF_TOKEN=

# Supabase (opcional, solo si FastAPI escribe directo)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# CORS: "*" en dev, en prod: "https://tu-frontend.vercel.app,https://pos.tudominio.com"
CORS_ORIGINS=*

# Render inyecta PORT automáticamente
PORT=8000
